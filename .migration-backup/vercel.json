{
  "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter @workspace/memorial run build:vercel",
  "outputDirectory": "artifacts/memorial/dist/public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
